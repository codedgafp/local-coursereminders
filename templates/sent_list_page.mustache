{{!
    @template local_coursereminders/sent_list_page

    Sent reminders list.

    Context variables required for this template:
    * courseid - The course id.
    * manageurl - URL of the reminder management page.
    * haslatestsend - Whether a reminder was already sent on the course.
    * latestsend - Sentence giving the latest send date on the course.
    * exportselector - Pre-rendered export format selector, only set when a reminder was sent.
    * hasusers - Whether at least one user is listed.
    * users - Array of user rows, each with id, fullname, profileurl, count, showbadge,
      lastsent, groupnames, messageurl, canunenrol and unenrolurl.
    * pagingbar - Pre-rendered paging bar HTML.

    Example context (json):
    {
        "courseid": 2,
        "manageurl": "#",
        "haslatestsend": true,
        "latestsend": "Latest reminder sent on this course: 19/12/25, 23:50",
        "exportselector": "",
        "hasusers": true,
        "users": [
            {
                "id": 3,
                "fullname": "Amélie Durand",
                "profileurl": "#",
                "count": 4,
                "showbadge": true,
                "lastsent": "19/12/25, 23:50",
                "groupnames": "Group A",
                "messageurl": "#",
                "canunenrol": true,
                "unenrolurl": "#"
            }
        ],
        "pagingbar": ""
    }
}}
<div class="local-coursereminders-sentlist">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h2 class="mb-0">{{#str}}sentlist:title, local_coursereminders{{/str}}</h2>
        <a href="{{manageurl}}" class="btn btn-secondary">{{#str}}backtomanage, local_coursereminders{{/str}}</a>
    </div>

    {{#haslatestsend}}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <p class="mb-0">{{latestsend}}</p>
        {{{exportselector}}}
    </div>
    {{/haslatestsend}}

    {{#hasusers}}
    <div class="table-responsive">
        <table class="table generaltable">
            <caption class="sr-only">{{#str}}sentlisttablecaption, local_coursereminders{{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}}col:user, local_coursereminders{{/str}}</th>
                    <th scope="col">{{#str}}col:lastsent, local_coursereminders{{/str}}</th>
                    <th scope="col">{{#str}}col:count, local_coursereminders{{/str}}</th>
                    <th scope="col">{{#str}}col:group, local_coursereminders{{/str}}</th>
                    <th scope="col">{{#str}}col:actions, local_coursereminders{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#users}}
                <tr>
                    <td><a href="{{profileurl}}">{{fullname}}</a></td>
                    <td>{{lastsent}}</td>
                    <td>
                        {{count}}
                        {{#showbadge}}
                        <span class="badge badge-danger ml-1">{{#str}}badge:inactive, local_coursereminders{{/str}}</span>
                        {{/showbadge}}
                    </td>
                    <td>{{groupnames}}</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-link p-1" type="button" id="cr-useractions-{{id}}"
                                data-toggle="dropdown" data-boundary="window"
                                data-bs-toggle="dropdown" data-bs-boundary="window" aria-haspopup="true"
                                aria-expanded="false"
                                aria-label="{{#str}}actionsforuser, local_coursereminders, {{fullname}}{{/str}}">
                                {{#pix}}i/menu, core{{/pix}}
                            </button>
                            <div class="dropdown-menu dropdown-menu-right dropdown-menu-end" aria-labelledby="cr-useractions-{{id}}">
                                <a class="dropdown-item" href="{{messageurl}}">
                                    {{#pix}}t/email, core{{/pix}}{{#str}}action:sendmessage, local_coursereminders{{/str}}
                                </a>
                                <button type="button" class="dropdown-item" data-action="cr-reminderlog"
                                    data-userid="{{id}}" data-fullname="{{fullname}}">
                                    {{#pix}}i/log, core{{/pix}}{{#str}}action:reminderlog, local_coursereminders{{/str}}
                                </button>
                                {{#canunenrol}}
                                <a class="dropdown-item" href="{{unenrolurl}}">
                                    {{#pix}}t/removecontact, core{{/pix}}{{#str}}action:unenrol, local_coursereminders{{/str}}
                                </a>
                                {{/canunenrol}}
                            </div>
                        </div>
                    </td>
                </tr>
                {{/users}}
            </tbody>
        </table>
    </div>
    {{{pagingbar}}}
    {{/hasusers}}

    {{^hasusers}}
    <div class="alert alert-info" role="status">{{#str}}sentlist:nousers, local_coursereminders{{/str}}</div>
    {{/hasusers}}
</div>
{{#js}}
require(['local_coursereminders/sentlist'], function(SentList) {
    SentList.init({{courseid}});
});
{{/js}}
