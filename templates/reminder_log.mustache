{{!
    @template local_coursereminders/reminder_log

    Body of the reminder log modal: reminders sent to a user and projected upcoming ones.

    Context variables required for this template:
    * hassent - Whether reminders were already sent.
    * sent - Array of { label, detail, time } sent reminders.
    * hasprojected - Whether upcoming reminders are projected.
    * projected - Array of { label, detail, time } projected reminders.

    Example context (json):
    {
        "hassent": true,
        "sent": [
            { "label": "Inactivity", "detail": "Reminder: course", "time": "19/12/25, 23:50" }
        ],
        "hasprojected": true,
        "projected": [
            { "label": "Inactivity", "detail": "Reminder: course", "time": "26/12/25, 23:50" }
        ]
    }
}}
<div class="local-coursereminders-reminderlog">
    <h3 class="h5">{{#str}}reminderlog:sentheading, local_coursereminders{{/str}}</h3>
    {{#hassent}}
    <ul class="list-unstyled">
        {{#sent}}
        <li class="mb-1">
            <strong>{{time}}</strong> — {{label}}{{#detail}} ({{detail}}){{/detail}}
        </li>
        {{/sent}}
    </ul>
    {{/hassent}}
    {{^hassent}}
    <p>{{#str}}reminderlog:nosent, local_coursereminders{{/str}}</p>
    {{/hassent}}

    <h3 class="h5 mt-3">{{#str}}reminderlog:upcomingheading, local_coursereminders{{/str}}</h3>
    {{#hasprojected}}
    <ul class="list-unstyled">
        {{#projected}}
        <li class="mb-1">
            <strong>{{time}}</strong> — {{label}}{{#detail}} ({{detail}}){{/detail}}
        </li>
        {{/projected}}
    </ul>
    {{/hasprojected}}
    {{^hasprojected}}
    <p>{{#str}}reminderlog:noupcoming, local_coursereminders{{/str}}</p>
    {{/hasprojected}}
</div>
