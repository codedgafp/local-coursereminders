{{!
    @template local_coursereminders/manage_page

    Course-level reminder management page.

    Context variables required for this template:
    * courseid - The course id.
    * completionconfigured - Whether course completion is configured on the course.
    * sesskey - The current session key.
    * addurl - URL of the reminder creation form.
    * sentlisturl - URL of the sent reminders list.
    * actionurl - URL handling row and bulk actions.
    * hasrules - Whether at least one rule is configured.
    * bulkactions - Array of { value, label } bulk action options.
    * rules - Array of rule rows, each with id, typename, delaylabel, lastsent,
      groupname, enabled, statuslabel and the editurl/duplicateurl/toggleurl/togglelabel/deleteurl actions.

    Example context (json):
    {
        "courseid": 2,
        "completionconfigured": true,
        "sesskey": "abc123",
        "addurl": "#",
        "sentlisturl": "#",
        "actionurl": "#",
        "hasrules": true,
        "bulkactions": [
            { "value": "enable", "label": "Enable" },
            { "value": "disable", "label": "Disable" },
            { "value": "delete", "label": "Delete" }
        ],
        "rules": [
            {
                "id": 1,
                "typename": "After enrolment",
                "delaylabel": "3 week(s)",
                "lastsent": "19/12/25, 23:50",
                "groupname": "Group A",
                "enabled": true,
                "statuslabel": "Enabled",
                "editurl": "#",
                "duplicateurl": "#",
                "toggleurl": "#",
                "togglelabel": "Disable",
                "deleteurl": "#"
            }
        ]
    }
}}
<div class="local-coursereminders-manage">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h2 class="mb-0">{{#str}}managepageheading, local_coursereminders{{/str}}</h2>
        <div class="btn-group" role="group">
            <a href="{{sentlisturl}}" class="btn btn-secondary">{{#str}}sentlist:title, local_coursereminders{{/str}}</a>
            <a href="{{addurl}}" class="btn btn-primary">{{#str}}addreminder, local_coursereminders{{/str}}</a>
        </div>
    </div>

    {{^completionconfigured}}
    <div class="alert alert-warning" role="alert">{{#str}}warning:nocompletion, local_coursereminders{{/str}}</div>
    {{/completionconfigured}}

    {{#hasrules}}
    <form method="post" action="{{actionurl}}" id="local-coursereminders-manageform" data-region="coursereminders-manage">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="courseid" value="{{courseid}}">

        <div class="table-responsive">
            <table class="table generaltable">
                <caption class="sr-only">{{#str}}managetablecaption, local_coursereminders{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col" class="text-center" style="width:3rem;">
                            <input type="checkbox" data-action="selectall"
                                aria-label="{{#str}}selectallreminders, local_coursereminders{{/str}}">
                        </th>
                        <th scope="col">{{#str}}col:type, local_coursereminders{{/str}}</th>
                        <th scope="col">{{#str}}col:delay, local_coursereminders{{/str}}</th>
                        <th scope="col">{{#str}}col:lastsent, local_coursereminders{{/str}}</th>
                        <th scope="col">{{#str}}col:group, local_coursereminders{{/str}}</th>
                        <th scope="col">{{#str}}col:status, local_coursereminders{{/str}}</th>
                        <th scope="col">{{#str}}col:actions, local_coursereminders{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rules}}
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" name="ruleids[]" value="{{id}}" data-action="select"
                                aria-label="{{#str}}selectreminder, local_coursereminders{{/str}}">
                        </td>
                        <td>{{typename}}</td>
                        <td>{{delaylabel}}</td>
                        <td>{{lastsent}}</td>
                        <td>{{groupname}}</td>
                        <td>
                            {{#enabled}}<span class="badge badge-success">{{statuslabel}}</span>{{/enabled}}
                            {{^enabled}}<span class="badge badge-warning">{{statuslabel}}</span>{{/enabled}}
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-link p-1" type="button" id="cr-actions-{{id}}"
                                    data-toggle="dropdown" data-boundary="window"
                                    data-bs-toggle="dropdown" data-bs-boundary="window" aria-haspopup="true"
                                    aria-expanded="false"
                                    aria-label="{{#str}}rowactions, local_coursereminders{{/str}}">
                                    {{#pix}}i/menu, core{{/pix}}
                                </button>
                                <div class="dropdown-menu dropdown-menu-right dropdown-menu-end" aria-labelledby="cr-actions-{{id}}">
                                    <a class="dropdown-item" href="{{editurl}}">
                                        {{#pix}}t/edit, core{{/pix}}{{#str}}action:edit, local_coursereminders{{/str}}
                                    </a>
                                    <a class="dropdown-item" href="{{duplicateurl}}">
                                        {{#pix}}t/copy, core{{/pix}}{{#str}}action:duplicate, local_coursereminders{{/str}}
                                    </a>
                                    <a class="dropdown-item" href="{{toggleurl}}">
                                        {{#enabled}}{{#pix}}t/hide, core{{/pix}}{{/enabled}}{{^enabled}}{{#pix}}t/show, core{{/pix}}{{/enabled}}{{togglelabel}}
                                    </a>
                                    <a class="dropdown-item" href="{{deleteurl}}">
                                        {{#pix}}t/delete, core{{/pix}}{{#str}}action:delete, local_coursereminders{{/str}}
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {{/rules}}
                </tbody>
            </table>
        </div>

        <div class="form-inline mt-2">
            <label for="local-coursereminders-bulkaction" class="mr-2">
                {{#str}}bulkactionlabel, local_coursereminders{{/str}}
            </label>
            <select id="local-coursereminders-bulkaction" name="bulkaction" class="custom-select mr-2" data-action="bulkaction">
                <option value="">{{#str}}choosedots{{/str}}</option>
                {{#bulkactions}}
                <option value="{{value}}">{{label}}</option>
                {{/bulkactions}}
            </select>
            <button type="submit" class="btn btn-secondary" name="bulk" value="1">{{#str}}go{{/str}}</button>
        </div>
    </form>
    {{/hasrules}}

    {{^hasrules}}
    <div class="alert alert-info" role="status">{{#str}}norules, local_coursereminders{{/str}}</div>
    {{/hasrules}}
</div>
{{#js}}
require(['local_coursereminders/manage'], function(Manage) {
    Manage.init();
});
{{/js}}
